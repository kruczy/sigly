{
  "name": "sigly-react",
  "version": "0.0.1",
  "private": false,
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prebuild": "pnpm --filter sigly build",
    "publish:npm": "pnpm build && npm publish",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "happy-dom": "^20.10.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sigly": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "sigly": ">=0.0.2"
  }
}
