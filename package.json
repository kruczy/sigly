{
  "name": "sigly-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r run build",
    "format": "oxfmt . --write",
    "format:check": "oxfmt . --check",
    "lint": "oxlint . --type-aware --vitest-plugin --deny-warnings",
    "lint:fix": "oxlint . --type-aware --vitest-plugin --fix",
    "playground": "pnpm --filter playground dev",
    "release:prepare": "node scripts/release.mjs prepare",
    "release:publish": "node scripts/release.mjs publish",
    "release:test": "node --test scripts/release.test.mjs",
    "test": "pnpm -r run test"
  },
  "devDependencies": {
    "oxfmt": "^0.54.0",
    "oxlint": "^1.69.0",
    "oxlint-tsgolint": "^0.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@10.12.1"
}
